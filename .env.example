# Variables del docker-compose.yml
# Copiar este archivo como .env y poner las contraseñas. El .env NUNCA se sube a GitHub.

MYSQL_ROOT_PASSWORD=
GATEWAY_DB_PASSWORD=
# Token interno: tiene que coincidir con el del gateway/.env
INTERNAL_TOKEN=
# Contraseñas de las bases de datos de cada servicio
INVENTARIO_DB_PASSWORD=
PROVEEDORES_DB_PASSWORD=
CATALOGO_DB_PASSWORD=
COMPRAS_DB_PASSWORD=
# Llaves secretas de Django
INVENTARIO_SECRET_KEY=
PROVEEDORES_SECRET_KEY=
# Correo de Notificaciones. Si SMTP_HOST queda vacío, el correo solo se muestra en los logs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

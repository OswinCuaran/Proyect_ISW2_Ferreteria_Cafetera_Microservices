//Microservicio de Catalogo
//Base de datos: catalogo_db (MySQL)

//Unidad de medida
Enum unidad_medida {
    UNIDAD
    PAR
    CAJA
    METRO
    ROLLO
    KILOGRAMO
    BULTO
    LITRO
    GALON
}

//Tabla Categoria
Table CATEGORIA [headercolor: #3A3F4B] {
    id int [pk, increment]
    categoria_padre_id int
    nombre varchar(100) [not null, unique]
    descripcion varchar(255)
    activa boolean [not null, default: true]
    created_at timestamp [not null, default: `now()`]
    updated_at timestamp [not null, default: `now()`]
}

//Tabla Producto
Table PRODUCTO [headercolor: #3A3F4B] {
    id int [pk, increment]
    categoria_id int [not null]
    proveedor_id int [not null]
    codigo varchar(30) [not null, unique]
    nombre varchar(150) [not null]
    descripcion text
    unidad_medida unidad_medida [not null]
    precio_venta decimal(14,2) [not null]
    activo boolean [not null, default: true]
    created_at timestamp [not null, default: `now()`]
    updated_at timestamp [not null, default: `now()`]
}

//Relaciones
Ref: CATEGORIA.categoria_padre_id >? CATEGORIA.id
Ref: PRODUCTO.categoria_id > CATEGORIA.id
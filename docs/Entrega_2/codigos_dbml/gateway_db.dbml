//API Gateway (Usuarios y Autenticacion)
//Base de datos: gateway_db (MySQL)

//Tipo de documento
Enum tipo_documento {
    CC
    CE
    PA
}

//Tabla Rol
Table ROL [headercolor: #2E7D5B] {
    id int [pk, increment]
    nombre varchar(30) [not null, unique]
    descripcion varchar(150)
}

//Tabla Permiso
Table PERMISO [headercolor: #2E7D5B] {
    id int [pk, increment]
    codigo varchar(80) [not null, unique]
    descripcion varchar(150)
}

//Tabla Rol_Permiso (Entidad debil entre Rol y Permiso)
Table ROL_PERMISO [headercolor: #2E7D5B] {
    rol_id int [not null]
    permiso_id int [not null]

    indexes {
        (rol_id, permiso_id) [pk]
    }

}

//Tabla Pregunta de seguridad
Table PREGUNTA_SEGURIDAD [headercolor: #2E7D5B] {
    id int [pk, increment]
    pregunta varchar(150) [not null, unique]
    activa boolean [not null, default: true]
}

//Tabla Usuario
Table USUARIO [headercolor: #2E7D5B] {
    id bigint [pk, increment]
    rol_id int [not null]
    pregunta_id int [not null]
    bodega_id int
    tipo_documento tipo_documento [not null]
    documento varchar(20) [not null]
    nombre varchar(100) [not null]
    apellido varchar(100) [not null]
    correo varchar(120) [not null, unique]
    password varchar(255) [not null]
    respuesta_seguridad varchar(255) [not null]
    activo boolean [not null, default: true]
    ultimo_acceso timestamp
    created_at timestamp [not null, default: `now()`]
    updated_at timestamp [not null, default: `now()`]

    indexes {
        (tipo_documento, documento) [unique]
    }

}

//Tabla de tokens de Sanctum
Table PERSONAL_ACCESS_TOKENS [headercolor: #2E7D5B] {
    id bigint [pk, increment]
    tokenable_type varchar(255) [not null]
    tokenable_id bigint [not null]
    name varchar(255) [not null]
    token varchar(64) [not null, unique]
    abilities text
    last_used_at timestamp
    expires_at timestamp
    created_at timestamp [not null, default: `now()`]
    updated_at timestamp [not null, default: `now()`]
}

//RELACIONES
Ref: USUARIO.rol_id > ROL.id
Ref: USUARIO.pregunta_id > PREGUNTA_SEGURIDAD.id
Ref: ROL_PERMISO.rol_id > ROL.id
Ref: ROL_PERMISO.permiso_id > PERMISO.id
Ref: PERSONAL_ACCESS_TOKENS.tokenable_id > USUARIO.id
//Microservicio de Proveedores
//Base de datos: proveedores_db (MySQL)

//Tipo de persona
Enum tipo_persona {
    NATURAL
    JURIDICA
}

//Tabla Proveedor
Table PROVEEDOR [headercolor: #2E7D5B] {
    id int [pk, increment]
    nit varchar(20) [not null, unique]
    tipo_persona tipo_persona [not null]
    razon_social varchar(150) [not null]
    nombre_comercial varchar(150)
    telefono varchar(20) [not null]
    correo varchar(120) [not null]
    direccion varchar(150) [not null]
    ciudad varchar(60) [not null]
    tiempo_entrega_dias int [not null, default: 1]
    activo boolean [not null, default: true]
    created_at timestamp [not null, default: `now()`]
    updated_at timestamp [not null, default: `now()`]
}

//Tabla Contacto del Proveedor
Table CONTACTO_PROVEEDOR [headercolor: #2E7D5B] {
    id int [pk, increment]
    proveedor_id int [not null]
    nombre varchar(100) [not null]
    cargo varchar(60)
    telefono varchar(20) [not null]
    correo varchar(120)
    es_principal boolean [not null, default: false]
    created_at timestamp [not null, default: `now()`]
    updated_at timestamp [not null, default: `now()`]
}

//RELACIONES
Ref: CONTACTO_PROVEEDOR.proveedor_id > PROVEEDOR.id
//Microservicio de Compras y devoluciones
//Base de datos: compras_devoluciones_db (MySQL)

//Estado de la orden de compra
Enum estado_orden {
    BORRADOR
    ENVIADA
    RECIBIDA_PARCIAL
    RECIBIDA
    CANCELADA
}

//Tipo de devolucion
Enum tipo_devolucion {
    CLIENTE
    PROVEEDOR
}

//Estado del producto devuelto
Enum estado_producto {
    BUEN_ESTADO
    DEFECTUOSO
}

//Tabla Orden de compra
Table ORDEN_COMPRA [headercolor: #2F6DB5] {
    id int [pk, increment]
    numero varchar(20) [not null, unique]
    proveedor_id int [not null]
    bodega_destino_id int [not null]
    usuario_id bigint [not null]
    estado estado_orden [not null, default: 'BORRADOR']
    fecha_emision date [not null]
    fecha_esperada date
    observacion varchar(255)
    created_at timestamp [not null, default: `now()`]
    updated_at timestamp [not null, default: `now()`]
}

//Tabla Detalle de la orden (Entidad debil de Orden de compra)
Table DETALLE_ORDEN [headercolor: #2F6DB5] {
    orden_id int [not null]
    producto_id int [not null]
    cantidad_pedida decimal(12,3) [not null]
    precio_unitario decimal(14,2) [not null]

    indexes {
        (orden_id, producto_id) [pk]
    }

}

//Tabla Recepcion
Table RECEPCION [headercolor: #2F6DB5] {
    id int [pk, increment]
    orden_id int [not null]
    usuario_id bigint [not null]
    observacion varchar(255)
    created_at timestamp [not null, default: `now()`]
}

//Tabla Detalle de la recepcion (Entidad debil de Recepcion)
Table DETALLE_RECEPCION [headercolor: #2F6DB5] {
    recepcion_id int [not null]
    producto_id int [not null]
    cantidad_recibida decimal(12,3) [not null]

    indexes {
        (recepcion_id, producto_id) [pk]
    }

}

//Tabla Devolucion
Table DEVOLUCION [headercolor: #2F6DB5] {
    id int [pk, increment]
    tipo tipo_devolucion [not null]
    orden_id int
    bodega_id int [not null]
    referencia_venta varchar(50)
    motivo varchar(255) [not null]
    usuario_id bigint [not null]
    created_at timestamp [not null, default: `now()`]
}

//Tabla Detalle de la devolucion (Entidad debil de Devolucion)
Table DETALLE_DEVOLUCION [headercolor: #2F6DB5] {
    devolucion_id int [not null]
    producto_id int [not null]
    cantidad decimal(12,3) [not null]
    estado_producto estado_producto [not null]

    indexes {
        (devolucion_id, producto_id) [pk]
    }

}

//RELACIONES
Ref: DETALLE_ORDEN.orden_id > ORDEN_COMPRA.id
Ref: RECEPCION.orden_id > ORDEN_COMPRA.id
Ref: DETALLE_RECEPCION.recepcion_id > RECEPCION.id
Ref: DEVOLUCION.orden_id >? ORDEN_COMPRA.id
Ref: DETALLE_DEVOLUCION.devolucion_id > DEVOLUCION.id
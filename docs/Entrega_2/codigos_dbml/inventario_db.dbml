//Microservicio de Inventario
//Bases de datos: inventario_db (MySQL)

//Naturaleza del movimiento
Enum naturaleza_movimiento {
    ENTRADA
    SALIDA
}

//Tabla Bodega
Table BODEGA [headercolor: #2E7D5B] {
    id int [pk, increment]
    codigo varchar(10) [not null, unique]
    nombre varchar(100) [not null]
    ciudad varchar(60) [not null]
    direccion varchar(150) [not null]
    telefono varchar(20) [not null]
    es_principal boolean [not null, default: false]
    activa boolean [not null, default: true]
    created_at timestamp [not null, default: `now()`]
    updated_at timestamp [not null, default: `now()`]
}

//Tabla Tipo de Movimiento
Table TIPO_MOVIMIENTO [headercolor: #2E7D5B] {
    id int [pk, increment]
    codigo varchar(30) [not null, unique]
    nombre varchar(80) [not null]
    naturaleza naturaleza_movimiento [not null]
}

//Tabla Existencia (Entidad debil de Bodega)
Table EXISTENCIA [headercolor: #2E7D5B] {
    bodega_id int [not null]
    producto_id int [not null]
    cantidad decimal (12,3) [not null, default: 0]
    stock_minimo decimal (12,3) [not null, default: 0]
    alerta_enviada boolean [not null, default: false]
    updated_at timestamp [not null, default: `now()`]

    indexes {
        (bodega_id, producto_id) [pk]
    }

}

//Tabla Traslado
Table TRASLADO [headercolor: #2E7D5B] {
    id int [pk, increment]
    bodega_origen_id int [not null]
    bodega_destino_id int [not null]
    usuario_id bigint [not null]
    observacion varchar(255)
    created_at timestamp [not null, default: `now()`]
}

//Tabla Movimiento
Table MOVIMIENTO [headercolor: #2E7D5B] {
    id bigint [pk, increment]
    tipo_movimiento_id int [not null]
    bodega_id int [not null]
    producto_id int [not null]
    traslado_id int
    cantidad decimal(12,3) [not null]
    saldo_resultante decimal(12,3) [not null]
    referencia varchar(50)
    motivo varchar(255)
    usuario_id bigint [not null]
    correlation_id varchar(36) [not null]
    created_at timestamp [not null, default: `now()`]
}

//RELACIONES
Ref: EXISTENCIA.bodega_id > BODEGA.id
Ref: MOVIMIENTO.(bodega_id, producto_id) > EXISTENCIA.(bodega_id, producto_id)
Ref: MOVIMIENTO.tipo_movimiento_id > TIPO_MOVIMIENTO.id
Ref: MOVIMIENTO.traslado_id >? TRASLADO.id
Ref: TRASLADO.bodega_origen_id > BODEGA.id
Ref: TRASLADO.bodega_destino_id > BODEGA.id